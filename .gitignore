# Patient / medical data -- NEVER commit these
*.nii
*.nii.gz
*.h5
*.hdf5
*.dcm
BraTS*/
brats_*/
**/patient_data/
**/raw_data/

# Trained model weights -- large binaries, don't belong in git.
# See artifacts/checkpoints/README.md for how to obtain/regenerate them.
*.pt
*.pth
*.ckpt
checkpoints/
artifacts/checkpoints/*.pt

# Local experiment scratch (anything not explicitly in results/ or experiments/)
runs/
outputs/
scratch/
*.log

# Secrets
*.env
.env.*
**/kaggle.json
**/*_token*
**/*_secret*
**/*api_key*

# Python
__pycache__/
*.pyc
*.egg-info/
build/
dist/
.pytest_cache/
.mypy_cache/
.ruff_cache/
*.egg

# OS / editor
.DS_Store
.vscode/
.idea/
*.swp

# Jupyter
.ipynb_checkpoints/

# Local paths that should never appear in a shared repo
/home/*/
/Users/*/
C:\Users\*
